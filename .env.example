# Copy to .env and fill in. Never commit .env.

# Required to run a review. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string. Any Postgres works; Neon is the easy path on Vercel.
DATABASE_URL=

# Shared secret the experiment-result webhook is signed with.
# Generate one with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# --- Public-demo guardrails ------------------------------------------------
# NOT IMPLEMENTED YET. These are the intended names; no code reads them today,
# so setting them protects nothing. Until that lands, do not put a live key on
# a deployment that anyone can reach.
#
# Reviews allowed per browser session before the app falls back to recorded
# responses. Unset means unlimited, which is what you want locally.
DEMO_REVIEWS_PER_SESSION=3

# Daily spend ceiling in USD. When the day's logged cost exceeds this, the app
# serves recorded responses instead of calling the model. Unset means no cap.
DEMO_DAILY_COST_CEILING_USD=5
