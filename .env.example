# Copy to .env and fill in. Never commit .env.

# Required to run a review. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string. Any Postgres works; Neon is the easy path on Vercel.
DATABASE_URL=

# Shared secret the experiment-result webhook is signed with.
# Generate one with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# --- Public-demo guardrails ------------------------------------------------
# Both are off when unset, which is what you want locally. Set them on any
# deployment that is reachable without a login. Both are checked before the
# model is called, so a blocked request costs nothing.
#
# Reviews allowed per browser session. Unset means unlimited.
DEMO_REVIEWS_PER_SESSION=3

# Daily spend ceiling in USD, counted from what each review actually cost.
# Resets at midnight UTC. Unset means no cap.
DEMO_DAILY_COST_CEILING_USD=5
